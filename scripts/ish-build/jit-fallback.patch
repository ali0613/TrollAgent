-    struct jit_units *units = jit_units_begin();
+    struct jit_units *units = jit_units_begin();  // 内部 pthread_once(jit_init) 初始化 jit_on；off 时返回 NULL
 #endif
     while (!state.oom) {
 #ifdef ISH_JIT
@@ -875,7 +878,7 @@ static struct fiber_block *fiber_block_compile(addr_t ip, struct tlb *tlb) {
 #endif
     state.block->used = state.capacity;
 #ifdef ISH_JIT
-    jit_block(state.block, units);
+    jit_block(state.block, units);  // U==NULL 时安全返回
 #endif
     return state.block;
 }
@@ -894,7 +897,8 @@ static void fiber_block_disconnect(struct asbestos *asbestos, struct fiber_block
             if (block->jump_ip[i] != NULL) {
                 *block->jump_ip[i] = block->old_jump_ip[i];
 #ifdef ISH_JIT
-                jit_unlink(block, i);
+                if (jit_on)
+                    jit_unlink(block, i);
 #endif
 #ifdef GUEST_ARM64
                 block->jump_ip_is_fake[i] = true;
@@ -922,7 +926,8 @@ static void fiber_block_disconnect(struct asbestos *asbestos, struct fiber_block
 static void fiber_block_free(struct asbestos *asbestos, struct fiber_block *block) {
     fiber_block_disconnect(asbestos, block);
 #ifdef ISH_JIT
-    jit_block_free(block);
+    if (jit_on)
+        jit_block_free(block);
 #endif
     free(block);
 }
